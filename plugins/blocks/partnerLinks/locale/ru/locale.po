msgid "plugins.block.partnerLinks.displayName"
msgstr "Блок «Партнёры и полезные ссылки»"

msgid "plugins.block.partnerLinks.description"
msgstr "Выводит на сайте журнала блок со ссылками на партнёров и наукометрические базы (с логотипами). Список ссылок настраивается в параметрах плагина."

msgid "plugins.block.partnerLinks.title"
msgstr "Партнёры и индексация"

msgid "plugins.block.partnerLinks.settings.description"
msgstr "Заполните строки по порядку, в котором ссылки должны идти в блоке. Пустые строки не выводятся. Чтобы удалить ссылку, очистите все поля строки."

msgid "plugins.block.partnerLinks.settings.blockTitle"
msgstr "Заголовок блока (если пусто — «Партнёры и индексация»)"

msgid "plugins.block.partnerLinks.settings.linkTitle"
msgstr "Название"

msgid "plugins.block.partnerLinks.settings.linkUrl"
msgstr "Адрес ссылки"

msgid "plugins.block.partnerLinks.settings.linkLogo"
msgstr "Логотип (адрес картинки)"

msgid "plugins.block.partnerLinks.settings.hint"
msgstr "Логотип можно загрузить через плагин «Библиотека файлов» и вставить сюда скопированную ссылку. Допускаются только адреса http:// и https://."

msgid "plugins.block.partnerLinks.error.titleRequired"
msgstr "У каждой заполненной строки должно быть название."

msgid "plugins.block.partnerLinks.error.invalidUrl"
msgstr "Адрес ссылки и логотипа должен начинаться с http:// или https://."
