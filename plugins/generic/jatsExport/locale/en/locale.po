msgstr "Unsign"

msgid "plugins.generic.jatsExport.metafora.resend"
msgstr "Resend"

msgid "plugins.generic.jatsExport.metafora.confirmSend"
msgstr "Send this article to Metafora? A record will be created in Metafora."

msgid "plugins.generic.jatsExport.metafora.confirmSendSelected"
msgstr "Send all selected articles to Metafora?"

msgid "plugins.generic.jatsExport.metafora.confirmSign"
msgstr "Sign the publication in Metafora? It can't be changed afterwards without unsigning."

msgid "plugins.generic.jatsExport.metafora.confirmUnsign"
msgstr "Remove the signature from the publication in Metafora?"

msgid "plugins.generic.jatsExport.metafora.confirmResend"
msgstr "Delete the article's file in Metafora and upload it again with the current data?"

