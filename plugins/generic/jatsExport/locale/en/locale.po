msgid "plugins.generic.jatsExport.displayName"
msgstr "JATS XML Export"

msgid "plugins.generic.jatsExport.description"
msgstr "Lets you pick any number of published articles and download their JATS XML as a single txt file or as separate xml files."

msgid "plugins.generic.jatsExport.manage"
msgstr "Export JATS XML"

msgid "plugins.generic.jatsExport.intro"
msgstr "Check articles or select all. 'Download TXT' puts every article into one text file, 'Download XML' gives one .xml or a ZIP for several. The Metafora buttons send articles (JATS XML + PDF galley) to the RCSI Metafora system and show their status there."

msgid "plugins.generic.jatsExport.selectAll"
msgstr "Select all"

msgid "plugins.generic.jatsExport.selectedCount"
msgstr "Selected"

msgid "plugins.generic.jatsExport.column.title"
msgstr "Title"

msgid "plugins.generic.jatsExport.exportTxt"
msgstr "Download TXT"

msgid "plugins.generic.jatsExport.exportXml"
msgstr "Download XML"

msgid "plugins.generic.jatsExport.export"
msgstr "Export"

msgid "plugins.generic.jatsExport.noArticles"
msgstr "No published articles yet."

msgid "plugins.generic.jatsExport.citationsEn"
msgstr "References (English)"

msgid "plugins.generic.jatsExport.citationsEn.description"
msgstr "English version of the reference list, one source per line. Numbering like \"1.\" may stay — it is removed in the JATS XML export and broken lines are joined."

msgid "plugins.generic.jatsExport.city"
msgstr "City"

msgid "plugins.generic.jatsExport.city.description"
msgstr "City of the author's affiliation in each language (e.g. Москва / Moscow). Used in the JATS XML for Metafora."

msgid "plugins.generic.jatsExport.column.metafora"
msgstr "Metafora"

msgid "plugins.generic.jatsExport.metafora.settings"
