msgstr "SPIN code (RSCI)"

msgid "plugins.generic.jatsExport.author.scopusId"
msgstr "Scopus Author ID"

msgid "plugins.generic.jatsExport.author.researcherId"
msgstr "ResearcherID (Web of Science)"

msgid "plugins.generic.jatsExport.pages.description"
msgstr "Page range of the article in the issue, first-last with a hyphen, e.g. 112-122. For a one-page article enter one number, e.g. 7."

msgid "plugins.generic.jatsExport.authorPosition"
msgstr "Author order"

msgid "plugins.generic.jatsExport.authorPosition.option"
msgstr "Author {$n}"

msgid "plugins.generic.jatsExport.authorPosition.description"
msgstr "Position in the article's list of authors. Author 1 is the lead author; the others shift automatically."

msgid "plugins.generic.jatsExport.orcid.description"
msgstr "The author's ORCID iD, e.g. 0000-0003-4018-234X (a https://orcid.org/… link works too)."

msgid "plugins.generic.jatsExport.metafora.delete"
msgstr "Delete from Metafora"

msgid "plugins.generic.jatsExport.metafora.confirmDelete"
msgstr "Delete the article from Metafora? The uploaded XML and the publication created from it will be removed. Nothing changes in OJS."

msgid "plugins.generic.jatsExport.metafora.origin.ojs"
msgstr "sent from OJS {$date}"

msgid "plugins.generic.jatsExport.metafora.origin.manual"
msgstr "already in Metafora — entered by hand"

msgid "plugins.generic.jatsExport.metafora.origin.file"
msgstr "already in Metafora — uploaded as a file"

msgid "plugins.generic.jatsExport.metafora.disabled.alreadySent"
msgstr "Already sent. Use Resend to upload it again."

msgid "plugins.generic.jatsExport.metafora.disabled.notSent"
msgstr "Not sent to Metafora yet."

msgid "plugins.generic.jatsExport.metafora.disabled.notProcessed"
msgstr "Metafora hasn't processed the file yet — click Refresh status."

msgid "plugins.generic.jatsExport.metafora.disabled.alreadySigned"
msgstr "The publication is already signed."

msgid "plugins.generic.jatsExport.metafora.disabled.notSigned"
msgstr "The publication is not signed."

msgid "plugins.generic.jatsExport.metafora.disabled.signed"
msgstr "The publication is signed — unsign it first."

msgid "plugins.generic.jatsExport.metafora.disabled.notFromOjs"
msgstr "Entered into Metafora outside OJS — only the editors can delete or replace it there."

