msgstr "paste the key from the 'API keys' section in Metafora"

msgid "plugins.generic.jatsExport.metafora.saveAndTest"
msgstr "Save and test"

msgid "plugins.generic.jatsExport.metafora.removeKey"
msgstr "Remove key"

msgid "plugins.generic.jatsExport.metafora.confirmRemoveKey"
msgstr "Remove the Metafora API key from OJS?"

msgid "plugins.generic.jatsExport.metafora.keySaved"
msgstr "API key saved."

msgid "plugins.generic.jatsExport.metafora.keyRemoved"
msgstr "API key removed."

msgid "plugins.generic.jatsExport.metafora.connectionOk"
msgstr "Connected to Metafora, the key was accepted."

msgid "plugins.generic.jatsExport.metafora.connectionFailed"
msgstr "Metafora did not accept the key."

msgid "plugins.generic.jatsExport.metafora.noKey"
msgstr "Save the Metafora API key first (box at the top of the page)."

msgid "plugins.generic.jatsExport.metafora.nothingSelected"
msgstr "No articles selected."

msgid "plugins.generic.jatsExport.metafora.refreshed"
msgstr "Statuses refreshed."

msgid "plugins.generic.jatsExport.metafora.selected"
msgstr "Metafora, selected:"

msgid "plugins.generic.jatsExport.metafora.send"
msgstr "Send"

msgid "plugins.generic.jatsExport.metafora.refresh"
msgstr "Refresh status"

