msgstr "Дата поступления в редакцию"

msgid "plugins.generic.jatsExport.dateAccepted"
msgstr "Дата принятия к публикации"

msgid "plugins.generic.jatsExport.funding"
msgstr "Сведения о финансировании"

msgid "plugins.generic.jatsExport.funding.description"
msgstr "Гранты, проекты, госзадание — как в тексте статьи."

msgid "plugins.generic.jatsExport.acknowledgments"
msgstr "Благодарности"

msgid "plugins.generic.jatsExport.author.spin"
msgstr "SPIN-код (РИНЦ)"

msgid "plugins.generic.jatsExport.author.scopusId"
msgstr "Scopus Author ID"

msgid "plugins.generic.jatsExport.author.researcherId"
msgstr "ResearcherID (Web of Science)"

msgid "plugins.generic.jatsExport.pages.description"
msgstr "Диапазон страниц статьи в выпуске через дефис: первая-последняя, например 112-122. Если статья на одной странице — один номер, например 7."

msgid "plugins.generic.jatsExport.authorPosition"
msgstr "Порядок автора"

msgid "plugins.generic.jatsExport.authorPosition.option"
msgstr "Автор {$n}"

msgid "plugins.generic.jatsExport.authorPosition.description"
msgstr "Место автора в списке авторов статьи. Автор 1 — основной (ведущий) автор. Остальные авторы сдвинутся автоматически."

msgid "plugins.generic.jatsExport.orcid.description"
msgstr "Идентификатор автора в ORCID, например 0000-0003-4018-234X (можно вставить и ссылку https://orcid.org/…)."

msgid "plugins.generic.jatsExport.metafora.delete"
msgstr "Удалить из Метафоры"

msgid "plugins.generic.jatsExport.metafora.confirmDelete"
msgstr "Удалить статью из ИС «Метафора»? Будут удалены загруженный XML и созданная из него публикация. В OJS статья не изменится."

