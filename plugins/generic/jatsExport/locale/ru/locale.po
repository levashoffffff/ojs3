msgstr "Переотправить"

msgid "plugins.generic.jatsExport.metafora.confirmSend"
msgstr "Отправить статью в Метафору? Будет создана запись в ИС «Метафора»."

msgid "plugins.generic.jatsExport.metafora.confirmSendSelected"
msgstr "Отправить все выбранные статьи в Метафору?"

msgid "plugins.generic.jatsExport.metafora.confirmSign"
msgstr "Подписать публикацию в Метафоре? После подписания изменения невозможны без снятия подписи."

msgid "plugins.generic.jatsExport.metafora.confirmUnsign"
msgstr "Снять подпись с публикации в Метафоре?"

msgid "plugins.generic.jatsExport.metafora.confirmResend"
msgstr "Удалить файл статьи в Метафоре и загрузить заново с текущими данными?"

