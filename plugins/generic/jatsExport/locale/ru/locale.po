msgstr "подписана {$date}"

msgid "plugins.generic.jatsExport.pubType"
msgstr "Тип публикации (для Метафоры)"

msgid "plugins.generic.jatsExport.pubType.description"
msgstr "Попадает в JATS XML как article-type."

