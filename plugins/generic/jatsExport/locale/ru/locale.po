msgstr "Связь с Метафорой есть, ключ принят."

msgid "plugins.generic.jatsExport.metafora.connectionFailed"
msgstr "Метафора не приняла ключ."

msgid "plugins.generic.jatsExport.metafora.noKey"
msgstr "Сначала сохраните API-ключ Метафоры (блок вверху страницы)."

