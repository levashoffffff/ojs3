msgid "author.submit.coverageInstructions"
msgstr "Относится к географическому местоположению, хронологическому или историческому охвату и/или характеристикам исследовательской выборки."

msgid "author.submit.languageInstructions"
msgstr ""
"Английский=en; Французский=fr; Испанский=es. <a href="https://www.loc.gov/standards/"
"iso639-2/php/code_list.php" target="_blank">Дополнительные коды</a>."

msgid "author.submit.form.authorRequired"
msgstr "Требуется как минимум один автор."

