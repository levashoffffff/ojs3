msgid "sushi.status.description"
msgstr "Отчеты об использовании COUNTER для {$contextName}."

msgid "sushi.exception.1"
msgstr ""
"Запрошенная дата ({$beginDate} или {$endDate}) приходится на середину месяца; "
"однако учитываются только полные месяцы."

msgid "sushi.exception.2"
msgstr ""
"Запрошенный ID элемента ({$itemId}) не является числом. Этот параметр ожидает "
"ID заявки."

msgid "sushi.exception.3"
msgstr ""
"Параметр item_id содержит более одного значения, однако принимается только одно. "
"Следующие значения не учитываются: item_id={$itemIdValues}"

msgid "sushi.exception.1030.missing"
msgstr "Отсутствует {$params}."

msgid "sushi.exception.1030.invalid"
msgstr "Недопустимый {$params}."

msgid "sushi.exception.3020.dateFormat"
msgstr "Неверный формат begin_date или end_date."

msgid "sushi.exception.3020.dateRange"
msgstr "Неверный диапазон дат."

msgid "sushi.exception.3030"
msgstr ""
"Нет данных об использовании за запрошенные даты. Запрос был на период с {$beginDate} по "
"{$endDate}."

msgid "sushi.exception.3031"
msgstr ""
"Запрос был на период с {$beginDate} по {$endDate}; однако данные об использовании доступны только "
"до {$lastDate}."

msgid "sushi.exception.3032"
msgstr ""
"Запрос был на период с {$beginDate} по {$endDate}; однако данные об использовании доступны только "
"с {$earliestDate}."

msgid "sushi.exception.3050"
msgstr ""
"Запрос содержал параметры ({$params}), которые не распознаются в "
"контексте обслуживаемого отчета."

msgid "sushi.exception.3060"
msgstr "Следующие значения фильтров не поддерживаются: {$filterValues}"

msgid "sushi.exception.3062"
msgstr "Следующие значения атрибутов не поддерживаются: {$attributeValues}"