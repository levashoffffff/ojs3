msgid "admin.error.gzDecompressFile.unlink"
msgstr ""
"Не удалось распаковать файл. Не удалось удалить распакованный исходный gz-файл {$filePath} с помощью unlink."

msgid "admin.error.gzCompressFile.gzopen"
msgstr ""
"Не удалось сжать файл. Не удалось открыть целевой gz-файл {$filePath} с помощью gzopen."

msgid "admin.error.gzCompressFile.fopen"
