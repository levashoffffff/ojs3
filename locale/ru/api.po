msgstr "Не удалось сохранить порядок выделенных материалов, так как один или несколько выделенных материалов не найдены."

msgid "api.highlights.404.highlightNotFound"
msgstr "Запрошенный вами выделенный материал не найден."

msgid "api.orcid.403.orcidNotEnabled"
msgstr "Вы не можете выполнить эту операцию, если функциональность ORCID отключена."

msgid "api.orcid.403.cannotUpdateAuthorOrcid"
msgstr "Назначение ORCID iD автора через конечные точки \"Редактировать/Добавить автора\" не разрешено. Чтобы запросить у автора обновление его ORCID iD, пожалуйста, используйте конечную точку \"orcid/requestAuthorVerification/{authorId}\"."

msgid "api.orcid.404.authorNotFound"
msgstr "Запрошенный автор не найден"

