msgstr "Этому элементу нельзя назначить DOI."

msgid "api.dois.403.pubTypeNotRecognized"
msgstr "Тип публикации не распознан."

msgid "api.dois.404.contextNotFound"
msgstr "Эта конечная точка недоступна из общесайтового пространства имен и должна запрашиваться для конкретного контекста."

msgid "api.dois.404.doiNotFound"
msgstr "Запрошенный вами DOI не найден."

