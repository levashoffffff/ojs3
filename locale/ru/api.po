msgstr "Загруженный вами файл не соответствует расширению файла. Это может произойти, когда файл был переименован в несовместимый тип, например, изменение photo.png на photo.jpg."

msgid "api.publicFiles.403.unauthorized"
msgstr "Вам не разрешено загружать файлы."

msgid "api.publicFiles.413.noDirSpace"
msgstr "У вас недостаточно места в вашем пользовательском каталоге. Размер загружаемого файла составляет {$fileUploadSize}КБ, а у вас осталось {$dirSizeLeft}КБ."

msgid "api.publicFiles.500.badFilesDir"
msgstr "Каталог общедоступных файлов не найден, или в него нельзя сохранить файлы. Пожалуйста, свяжитесь с вашим администратором для решения этой проблемы."

msgid "api.stats.400.wrongDateFormat"
