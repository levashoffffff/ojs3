msgstr "Запрошенный вами шаблон письма не найден."

msgid "api.emailLogs.400.unrecognisedAuthorEmailEventType"
msgstr "Вы указали неверный \"eventType\", {$eventType}, для писем авторов."

msgid "api.files.400.noUpload"
msgstr "В запросе не найден файл для загрузки."

msgid "api.files.400.uploadFailed"
msgstr "Не удалось загрузить один или несколько файлов."

msgid "api.files.400.fileSize"
msgstr "Файлы размером более {$maxSize} не могут быть загружены."

msgid "api.files.400.config"
msgstr "Не удалось загрузить файл из-за ошибки конфигурации сервера. Пожалуйста, свяжитесь с администратором системы."

msgid "api.highlights.400.noOrderData"
msgstr "Не удалось сохранить порядок выделенных материалов, так как информация о порядке не найдена."

