msgstr "Имя получателя приглашения"

msgid "emailTemplate.variable.invitation.inviterName"
msgstr "Имя отправителя приглашения"

msgid "emailTemplate.variable.invitation.inviterRole"
msgstr "Роль отправителя приглашения"

msgid "emailTemplate.variable.invitation.rolesAdded"
msgstr "В этом разделе описываются роли, которые будут добавлены пользователю после принятия приглашения"

msgid "emailTemplate.variable.invitation.existingRoles"
msgstr "В этом разделе описываются роли, которые у пользователя уже есть."

msgid "emailTemplate.variable.invitation.acceptUrl"
msgstr "URL для принятия приглашения"

msgid "emailTemplate.variable.invitation.declineUrl"
msgstr "URL для отклонения приглашения"

msgid "mailable.userRoleEndNotify.name"
msgstr "Уведомление об окончании срока действия роли пользователя"

msgid "mailable.userRoleEndNotify.description"
msgstr "Уведомление по электронной почте, отправляемое пользователю при удалении его из роли."

msgid "orcid.orcidCollectAuthorId.name"
msgstr "Сбор ORCID автора"

